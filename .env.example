# Zachi Smart-POS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file.

# ---- Server ----
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# ---- PostgreSQL ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/zachi_pos

# ---- JWT ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=12h

# ---- CORS ----
# Comma-separated list of allowed origins for the web app.
# Native shells (Capacitor, Tauri) and same-origin requests are allowed automatically.
CORS_ORIGIN=https://pos.zachicomputercentre.com

# ---- Email (Gmail App Password recommended) ----
# Required for the password-reset flow; can be left blank in dev.
EMAIL_USER=
EMAIL_PASS=

# ---- Public base URL used in password-reset emails ----
APP_BASE_URL=https://pos.zachicomputercentre.com
